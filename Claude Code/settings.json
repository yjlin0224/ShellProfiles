{
  "env": {
    "EDITOR": "code",
    "FORCE_HYPERLINK": "1",
    "CLAUDE_CODE_SILENT_TURN_REMINDER_TEXT": "使用者一段時間沒收到你的消息了。用繁體中文簡短說明你正在做什麼、發現了什麼、或有計劃變更，然後繼續。"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "skipAutoPermissionPrompt": true
  },
  "allowManagedHooksOnly": true,
  "allowedHttpHookUrls": [],
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.mjs",
    "refreshInterval": 5
  },
  "language": "繁體中文",
  "effortLevel": "high",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "timeFormat": "%m/%d %I:%M:%S %p",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "copyOnSelect": false,
  "externalEditorContext": true,
  "leftArrowOpensAgents": false,
  "model": "opus"
}
